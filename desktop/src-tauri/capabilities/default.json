{
  "identifier": "main-capability",
  "description": "Main window local health, chat, transcription and speech",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://127.0.0.1:*/health"
        },
        {
          "url": "http://localhost:*/health"
        },
        {
          "url": "http://127.0.0.1:*/api/v1/chat"
        },
        {
          "url": "http://localhost:*/api/v1/chat"
        },
        {
          "url": "http://127.0.0.1:*/api/v1/transcribe"
        },
        {
          "url": "http://127.0.0.1:*/api/v1/speak"
        },
        {
          "url": "http://localhost:*/api/v1/transcribe"
        },
        {
          "url": "http://localhost:*/api/v1/speak"
        }
      ]
    }
  ]
}
