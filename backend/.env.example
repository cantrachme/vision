# Default: local Ollama, no API key needed.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct
# Install once: ollama pull qwen3:4b-instruct

# Optional cloud provider: set LLM_PROVIDER=openai and supply your own key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Local CPU speech recognition. First use downloads weights; cache for offline use.
# A local converted model directory can also be supplied.
WHISPER_MODEL=base
